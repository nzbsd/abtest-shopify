{%- comment -%}
  Price test: send part of the traffic to a duplicate product with a different
  price.

  WHERE TO PUT THIS
  In the <head>, on every product page. In theme.liquid before </head> is
  simplest, or in the product template if you prefer. Fill in app_base below.

  Placing it in the head matters: the redirect should happen before the page
  paints, otherwise the visitor briefly sees the original price.

  HOW IT WORKS
  1. Fetch the running tests from the app.
  2. Assign the visitor to a group once and remember it in a cookie, so a
     return visit shows the same price. A price that moves between visits is a
     support ticket waiting to happen, and it ruins the measurement.
  3. Test group on the original product: replace the location with the
     duplicate's URL. That page then renders itself - real prices, real
     quantity tiers, real subscription, real currency.
  4. Report view and add-to-cart to the app.

  WHY A REDIRECT AND NOT REWRITING PRICES
  An earlier version rewrote the prices in place. On this store that turned out
  to be a bad idea: the product page shows quantity tiers, a subscription
  discount and market pricing, all computed by the theme. Rewriting means
  reimplementing that arithmetic and keeping it correct forever, and any theme
  change silently breaks it - in the worst case showing one price and charging
  another. Redirecting hands all of it back to Shopify, which already gets it
  right.

  WHAT IT COSTS
  The URL changes to the duplicate's. The first visit has a short delay while
  the config is fetched; after that the decision is cached and the redirect is
  immediate. location.replace is used rather than assigning href, so the back
  button does not bounce the visitor into a loop.

  BEFORE YOU RUN A TEST
  Set the duplicate to "unlisted" so it stays out of search and collections,
  and give it a canonical tag pointing at the original if your theme does not
  already. Two near-identical public product pages is not something you want
  Google to see.
{%- endcomment -%}

{%- assign app_base = 'https://abtest-shopify.vercel.app' -%}

{%- if product -%}
<script>
(function () {
  var APP = {{ app_base | json }};
  var SHOP = {{ shop.permanent_domain | json }};
  var PRODUCT_ID = {{ product.id | json }};
  var MARKET = {{ localization.market.handle | default: '' | json }};
  var CURRENCY = {{ cart.currency.iso_code | default: shop.currency | json }};
  if (!PRODUCT_ID) return;

  var COOKIE = "_pt_v";
  var CACHE = "_pt_cfg";
  var CACHE_MS = 120000;   /* two minutes: long enough to skip the fetch on a
                              browse session, short enough that stopping a test
                              takes effect while you are still watching. */

  function readCookie(name) {
    var m = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
    return m ? decodeURIComponent(m[2]) : null;
  }
  function writeCookie(name, value, days) {
    var d = new Date();
    d.setTime(d.getTime() + days * 864e5);
    document.cookie = name + "=" + encodeURIComponent(value) +
      ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax";
  }

  /* Visitor id: only to keep the same person in the same group and to
     de-duplicate views. No personal data. */
  var visitor = readCookie(COOKIE);
  if (!visitor) {
    visitor = Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
    writeCookie(COOKIE, visitor, 180);
  }

  /* Stable assignment: derive a number 0-99 from visitor + test id. The same
     visitor and the same test always land in the same group, without storing
     the choice anywhere. */
  function bucket(key) {
    var h = 0;
    for (var i = 0; i < key.length; i++) h = ((h << 5) - h + key.charCodeAt(i)) | 0;
    return Math.abs(h) % 100;
  }

  function report(testId, cohort, type) {
    try {
      navigator.sendBeacon(
        APP + "/api/price-test-event",
        new Blob([JSON.stringify({
          shop: SHOP, testId: testId, cohort: cohort, eventType: type,
          productId: PRODUCT_ID, market: MARKET, currency: CURRENCY, visitorId: visitor
        })], { type: "application/json" })
      );
    } catch (e) { /* a failed measurement must never hold up the store */ }
  }

  /* Cart attributes travel into the order, which is how the webhook knows the
     market and visitor behind a purchase. The group itself is decided there by
     which product was bought, so this is context rather than the source of
     truth. */
  function tagCart(testId, cohort) {
    try {
      fetch("/cart/update.js", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          attributes: {
            _pt_cohort: cohort, _pt_test: String(testId),
            _pt_market: MARKET, _pt_visitor: visitor
          }
        })
      }).catch(function () {});
    } catch (e) {}
  }

  function watchAddToCart(testId, cohort) {
    document.addEventListener("submit", function (e) {
      var f = e.target;
      if (f && f.action && f.action.indexOf("/cart/add") !== -1) report(testId, cohort, "atc");
    }, true);
  }

  function handle(data) {
    var tests = (data && data.tests) || [];

    /* Are we on the duplicate? Then the visitor was sent here, or landed here
       directly. Either way: no redirect, just measure. */
    var asTest = tests.filter(function (t) { return t.testProductId === PRODUCT_ID; })[0];
    if (asTest) {
      report(asTest.id, "test", "view");
      tagCart(asTest.id, "test");
      watchAddToCart(asTest.id, "test");
      return;
    }

    var test = tests.filter(function (t) { return t.controlProductId === PRODUCT_ID; })[0];
    if (!test) return;

    var cohort = bucket(visitor + ":" + test.id) < test.splitPct ? "test" : "control";

    if (cohort === "control") {
      report(test.id, "control", "view");
      tagCart(test.id, "control");
      watchAddToCart(test.id, "control");
      return;
    }

    /* Test group: hand the visitor to the duplicate. Query parameters are kept
       so ad tracking and utm tags survive; a ?variant= is mapped through when
       we know the matching variant, otherwise dropped rather than pointing at
       a variant that belongs to the other product. */
    var url = new URL(window.location.href);
    var params = new URLSearchParams(url.search);
    var variant = params.get("variant");
    if (variant) {
      var mapped = (test.variantMap || {})[String(variant)];
      if (mapped) params.set("variant", String(mapped));
      else params.delete("variant");
    }
    var query = params.toString();
    var target = "/products/" + test.testHandle + (query ? "?" + query : "") + url.hash;

    /* replace and not assign: otherwise the back button lands on the original,
       which redirects again, and the visitor is stuck. */
    window.location.replace(target);
  }

  /* Cached config first so a returning visitor is redirected without waiting
     for the network. */
  try {
    var raw = sessionStorage.getItem(CACHE);
    if (raw) {
      var cached = JSON.parse(raw);
      if (cached && cached.at && Date.now() - cached.at < CACHE_MS) {
        handle(cached.data);
        return;
      }
    }
  } catch (e) { /* private mode, no storage - just fetch */ }

  fetch(APP + "/api/price-test?shop=" + encodeURIComponent(SHOP))
    .then(function (r) { return r.ok ? r.json() : { tests: [] }; })
    .then(function (data) {
      try { sessionStorage.setItem(CACHE, JSON.stringify({ at: Date.now(), data: data })); } catch (e) {}
      handle(data);
    })
    .catch(function () { /* no config, no test: the visitor sees the original */ });
})();
</script>
{%- endif -%}
