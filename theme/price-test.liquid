{%- comment -%}
  Prijstest — cohorttoewijzing en meting.

  PLAATSING: als snippet in het thema, gerenderd op productpagina's.
  Bijvoorbeeld met {% render 'price-test' %} in het product-template, of via
  een app-embed block.

  WAT DIT DOET
  1. Haalt de lopende tests op bij de app ({{ app_base }}/api/price-test)
  2. Wijst de bezoeker één keer een groep toe en onthoudt dat in een cookie,
     zodat hij bij terugkomst dezelfde prijs ziet. Een wisselende prijs is een
     klachtenmagneet en maakt de meting waardeloos.
  3. Zet _pt_cohort, _pt_test, _pt_market en _pt_visitor als cart-attributen.
     Daar leest zowel de Discount Function als de orders-webhook uit.
  4. Meldt een view en een add-to-cart bij de app.

  WAT DIT NIET DOET
  Prijzen tonen of aanpassen. De prijs die je ziet komt uit Shopify zelf: voor
  de testgroep de vaste prijs uit de price list, voor de controlegroep dezelfde
  prijs met de teruggave van de Function in de cart. Zou dit script de
  weergegeven prijs zelf verzinnen, dan kan hij afwijken van wat er wordt
  afgerekend — en dat is precies het soort verschil waar klanten over mailen.
{%- endcomment -%}

<script>
(function () {
  var APP = "{{ app_base | default: 'https://REPLACE-MET-VERCEL-URL' }}";
  var SHOP = "{{ shop.permanent_domain }}";
  var PRODUCT_ID = {{ product.id | default: 0 }};
  var MARKET = "{{ localization.market.handle | default: '' }}";
  var CURRENCY = "{{ cart.currency.iso_code | default: shop.currency }}";
  if (!PRODUCT_ID) return;

  var COOKIE = "_pt_v";
  function cookie(naam) {
    var m = document.cookie.match(new RegExp("(^| )" + naam + "=([^;]+)"));
    return m ? decodeURIComponent(m[2]) : null;
  }
  function zetCookie(naam, waarde, dagen) {
    var d = new Date(); d.setTime(d.getTime() + dagen * 864e5);
    document.cookie = naam + "=" + encodeURIComponent(waarde) + ";expires=" + d.toUTCString() + ";path=/;SameSite=Lax";
  }

  /* Bezoekers-id: puur een willekeurig getal om dezelfde bezoeker in dezelfde
     groep te houden en views te kunnen ontdubbelen. Geen persoonsgegevens. */
  var visitor = cookie(COOKIE);
  if (!visitor) {
    visitor = (Date.now().toString(36) + Math.random().toString(36).slice(2, 10));
    zetCookie(COOKIE, visitor, 180);
  }

  /* Stabiele toewijzing: uit visitor + test-id een getal 0-99 afleiden. Zelfde
     bezoeker en zelfde test geeft altijd dezelfde uitkomst, ook zonder dat we
     de keuze apart opslaan. */
  function bucket(sleutel) {
    var h = 0;
    for (var i = 0; i < sleutel.length; i++) { h = ((h << 5) - h + sleutel.charCodeAt(i)) | 0; }
    return Math.abs(h) % 100;
  }

  function meld(testId, cohort, type) {
    try {
      navigator.sendBeacon(
        APP + "/api/price-test-event",
        new Blob([JSON.stringify({
          shop: SHOP, testId: testId, cohort: cohort, eventType: type,
          productId: PRODUCT_ID, market: MARKET, currency: CURRENCY, visitorId: visitor
        })], { type: "application/json" })
      );
    } catch (e) { /* meting mag de winkel nooit ophouden */ }
  }

  fetch(APP + "/api/price-test?shop=" + encodeURIComponent(SHOP))
    .then(function (r) { return r.ok ? r.json() : { tests: [] }; })
    .then(function (data) {
      var test = (data.tests || []).filter(function (t) { return t.productId === PRODUCT_ID; })[0];
      if (!test) return;
      if (MARKET && test.markets && !test.markets[MARKET] && !test.markets[CURRENCY]) return;

      var cohort = bucket(visitor + ":" + test.id) < test.splitPct ? "test" : "control";

      /* Cart-attributen zetten. Dit is wat de Discount Function leest; zonder
         deze attributen krijgt niemand een teruggave en betaalt iedereen de
         testprijs. Daarom bij ELKE pageview zetten, niet alleen bij de eerste:
         een cart kan geleegd of vervangen zijn. */
      fetch("/cart/update.js", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({
          attributes: {
            _pt_cohort: cohort,
            _pt_test: String(test.id),
            _pt_market: MARKET,
            _pt_visitor: visitor
          }
        })
      }).catch(function () {});

      meld(test.id, cohort, "view");

      document.addEventListener("submit", function (e) {
        var f = e.target;
        if (f && f.action && f.action.indexOf("/cart/add") !== -1) meld(test.id, cohort, "atc");
      }, true);
    })
    .catch(function () { /* geen test, geen gedoe */ });
})();
</script>
